/* WhatsApp Forensicator — High Contrast QSS Theme */

QMainWindow { background-color: #000000; }
QWidget {
    background-color: transparent;
    color: #FFFFFF;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 14px;
}
QLabel { background: transparent; color: #FFFFFF; border: none; }
QLabel#pageTitle { font-size: 20px; font-weight: 700; color: #00FF66; }
QLabel#kpiValue { font-size: 24px; font-weight: 700; color: #33FF88; }
QPushButton {
    background-color: #00CC44; color: #000000; border: 2px solid #00FF66;
    border-radius: 4px; padding: 8px 20px; font-size: 14px; font-weight: 700;
    min-height: 36px;
}
QPushButton:hover { background-color: #00FF66; border: 2px solid #FFFFFF; }
QPushButton:disabled { background-color: #333333; color: #666666; border: 2px solid #555555; }
QPushButton#secondaryButton {
    background-color: transparent; color: #00FF66; border: 2px solid #00FF66;
}
QPushButton#destructiveButton { background-color: #FF3333; color: #FFFFFF; border: 2px solid #FF6666; }
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #000000; color: #FFFFFF; border: 2px solid #FFFFFF;
    border-radius: 4px; padding: 6px 10px; font-size: 14px; min-height: 32px;
}
QLineEdit:focus { border: 2px solid #00FF66; }
QComboBox {
    background-color: #000000; color: #FFFFFF; border: 2px solid #FFFFFF;
    border-radius: 4px; padding: 6px 10px; min-height: 32px;
}
QComboBox QAbstractItemView {
    background-color: #141414; color: #FFFFFF; border: 2px solid #FFFFFF;
    selection-background-color: #222222;
}
QTableView {
    background-color: #000000; color: #FFFFFF; border: 2px solid #FFFFFF;
    gridline-color: #333333; selection-background-color: #222222;
    font-size: 13px;
}
QTableView QHeaderView::section {
    background-color: #000000; color: #FFFFFF; border: none;
    border-bottom: 2px solid #FFFFFF; padding: 8px; font-size: 12px; font-weight: 700;
}
QListWidget {
    background-color: #000000; color: #FFFFFF; border: 2px solid #FFFFFF;
}
QListWidget::item:selected { background-color: #222222; color: #00FF66; }
QTabBar::tab {
    background-color: #000000; color: #999999; border: 2px solid transparent;
    padding: 8px 16px; font-size: 13px; font-weight: 700;
}
QTabBar::tab:selected { background-color: #141414; color: #00FF66; border: 2px solid #00FF66; }
QTabWidget::pane { background-color: #141414; border: 2px solid #FFFFFF; }
QScrollBar:vertical { background: #000000; width: 14px; }
QScrollBar::handle:vertical { background: #FFFFFF; min-height: 30px; }
QStatusBar { background-color: #000000; color: #FFFFFF; border-top: 2px solid #FFFFFF; font-size: 12px; }
QProgressBar { background-color: #000000; border: 2px solid #FFFFFF; text-align: center; color: #FFFFFF; }
QProgressBar::chunk { background-color: #00FF66; }
QCheckBox::indicator { width: 20px; height: 20px; border: 2px solid #FFFFFF; background: #000000; }
QCheckBox::indicator:checked { background: #00FF66; border: 2px solid #00FF66; }
QRadioButton::indicator { width: 20px; height: 20px; border: 2px solid #FFFFFF; background: #000000; }
QRadioButton::indicator:checked { background: #00FF66; border: 2px solid #00FF66; }
QGroupBox { background-color: #141414; border: 2px solid #FFFFFF; margin-top: 16px; padding: 16px; }
QDialog { background-color: #141414; border: 2px solid #FFFFFF; }
QToolTip { background-color: #141414; color: #FFFFFF; border: 2px solid #FFFFFF; font-size: 13px; }
